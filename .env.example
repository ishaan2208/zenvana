NEXT_PUBLIC_BACKEND_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3009
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_api_key

# Contact form emails are sent by the backend (POST /api/v1/public/contact).
# On the API server: configure MAIL_* (see backend docs). Optional: ZENVANA_CONTACT_TO_EMAIL=admin@zenvanahotels.com

# Optional local Next.js API mail settings (pages/api/contact.js and pages/api/event-booking.js)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admin@zenvana.com
SMTP_PASS=your_smtp_password
CONTACT_FROM_EMAIL=admin@zenvana.com
CONTACT_TO_EMAIL=admin@zenvana.com
