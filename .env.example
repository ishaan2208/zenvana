# ---- Blog admin (/internal/blogs-admin) ----
# Password for the internal blog CMS. Defaults to admin123 if unset.
# BLOG_ADMIN_PASSWORD=your-strong-password
# Force Secure cookie off when testing production build on http://localhost (optional)
# BLOG_ADMIN_COOKIE_SECURE=false

# ---- Blog CMS database (Neon Postgres) ----
# Uses a dedicated `blog` schema for isolation. Point at your Neon database (pooler + direct URLs).
# Prisma CLI reads `.env` by default; Next.js dev reads `.env.local`. Keep both in sync.
# DATABASE_URL = pooler host (-pooler in hostname). DIRECT_URL = direct host (no pooler).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/blogs?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/blogs?sslmode=require

# ---- Cloudinary (blog media uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

NEXT_PUBLIC_BACKEND_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3009
# Browser key for embedded maps only (loaded on "View map" click — not on page load).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_api_key

# ---- Analytics & marketing tags (all optional, env-gated) ----
# Google Analytics 4 — Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Tag Manager container ID, e.g. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=
# Google Ads global site tag, e.g. AW-XXXXXXXXXX (defaults to AW-16548808937)
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Google Ads homepage conversion send_to (defaults to AW-16548808937/faA3CKXP7K0ZEOmRi9M9)
NEXT_PUBLIC_GOOGLE_ADS_HOME_CONVERSION=AW-16548808937
# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
# First-party analytics hashing salt (required in production)
ANALYTICS_SALT=
# Internal analytics admin
ANALYTICS_ADMIN_PASSWORD=
ANALYTICS_ADMIN_SESSION_SECRET=
ANALYTICS_ROLLUP_SECRET=
# Optional override for analytics cookie security (true/false)
# ANALYTICS_ADMIN_COOKIE_SECURE=true

# ---- Homepage Google reviews (Guest Voices) ----
# Served from the backend cache (GET /api/v1/public/google-reviews), refreshed daily
# by the google-ratings-snapshot cron. No Google Places API key needed in zenvana.

# ---- Search engine site verification ----
# Google Search Console — content of the meta tag (no <meta> wrapper)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification token
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Meta Business / Facebook domain verification
NEXT_PUBLIC_FB_DOMAIN_VERIFICATION=

# ---- Mail (existing) ----
# Contact form emails are sent by the backend (POST /api/v1/public/contact).
# On the API server: configure MAIL_* (see backend docs). Optional: ZENVANA_CONTACT_TO_EMAIL=admin@zenvanahotels.com

# Optional local Next.js API mail settings (pages/api/contact.js and pages/api/event-booking.js)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admin@zenvana.com
SMTP_PASS=your_smtp_password
CONTACT_FROM_EMAIL=admin@zenvana.com
CONTACT_TO_EMAIL=admin@zenvana.com

# ---- Razorpay (existing, do not edit on a marketing PR) ----
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
