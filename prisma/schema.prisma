generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["blog", "analytics"]
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED

  @@schema("blog")
}

enum BlogMediaType {
  IMAGE
  VIDEO

  @@schema("blog")
}

enum BlogMediaRole {
  HERO_DESKTOP
  HERO_MOBILE
  THUMBNAIL
  OG
  INLINE
  GALLERY

  @@schema("blog")
}

model BlogPost {
  id            String  @id @default(cuid())
  slug          String  @unique
  title         String
  excerpt       String
  contentHtml   String  @db.Text
  alternateHref String?

  seoTitle           String?
  seoDescription     String?
  seoKeywords        String[] @default([])
  canonicalUrl       String?
  ogTitle            String?
  ogDescription      String?
  ogImageUrl         String?
  twitterTitle       String?
  twitterDescription String?
  twitterImageUrl    String?

  heroImageUrl String?
  authorName   String  @default("Zenvana Hotels")

  status      BlogPostStatus @default(DRAFT)
  publishedAt DateTime?
  isIndexable Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media BlogMedia[]

  @@index([status, publishedAt])
  @@schema("blog")
}

model BlogMedia {
  id         String   @id @default(cuid())
  blogPostId String
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  type      BlogMediaType
  role      BlogMediaRole @default(GALLERY)
  url       String
  publicId  String?
  width     Int?
  height    Int?
  duration  Int?
  bytes     Int?
  format    String?
  altText   String?
  sortOrder Int           @default(0)

  createdAt DateTime @default(now())

  @@index([blogPostId, sortOrder])
  @@index([blogPostId, role])
  @@schema("blog")
}

model BlogSlugRedirect {
  fromSlug  String   @id
  toSlug    String
  createdAt DateTime @default(now())

  @@index([toSlug])
  @@schema("blog")
}

// =========================================================
// Analytics: first-party event tracking (booking funnel)
// =========================================================

model AnalyticsSession {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  landingPath   String
  referrer      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmTerm       String?
  utmContent    String?
  deviceType    String?
  country       String?
  userAgentHash String?
  ipHash        String?

  events AnalyticsEvent[]

  @@index([createdAt])
  @@index([utmSource, createdAt])
  @@index([country, createdAt])
  @@map("session")
  @@schema("analytics")
}

model AnalyticsEvent {
  id             BigInt   @id @default(autoincrement())
  sessionId      String
  session        AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name           String
  eventId        String?
  occurredAt     DateTime @default(now())
  bookingReference String?
  propertySlug   String?
  source         String
  properties     Json     @db.JsonB
  propertiesSize Int?
  utmSource      String?

  @@index([name, occurredAt])
  @@index([occurredAt])
  @@index([sessionId, occurredAt])
  @@index([bookingReference, occurredAt])
  @@index([propertySlug, name, occurredAt])
  @@index([utmSource, name, occurredAt])
  @@unique([sessionId, eventId])
  @@map("event")
  @@schema("analytics")
}

model AnalyticsDailyMetric {
  date         DateTime
  propertySlug String
  utmSource    String
  sessions     Int      @default(0)
  bookings     Int      @default(0)
  events       Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@id([date, propertySlug, utmSource])
  @@index([date])
  @@index([propertySlug, date])
  @@index([utmSource, date])
  @@map("daily_metrics")
  @@schema("analytics")
}
